{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(cat src/**)",
      "Bash(cat __tests__/**)",
      "Bash(find src *)",
      "Bash(find __tests__ *)",
      "Read",
      "Write",
      "Edit"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force)",
      "Bash(git reset --hard*)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(cat .env*)",
      "Bash(cat .secrets*)",
      "Bash(cat *.key)",
      "Bash(cat *.pem)",
      "Read(.env*)",
      "Read(.secrets*)",
      "Read(*.key)",
      "Read(*.pem)",
      "Write(.env*)",
      "Write(.secrets*)",
      "Edit(.env*)",
      "Edit(.secrets*)"
    ]
  },
  "env": {
    "CLAUDE_PROJECT_TYPE": "web-app",
    "CLAUDE_LANG": "ja",
    "CLAUDE_PRESET": "full"
  }
}
